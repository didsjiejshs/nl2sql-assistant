# ============================================================
# 复制本文件为 .env 后填入你自己的 Key（.env 已在 .gitignore 中，不会被提交）
# 不填任何 Key 也可以运行 —— 会自动切换到【演示模式】（规则解析，无需联网）
# ============================================================

# 可选值：openai / deepseek / dashscope / ollama / mock
LLM_PROVIDER=mock

# DeepSeek（推荐，便宜且中文好，注册即送额度）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# 阿里云百炼 / 通义千问
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen-plus

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 本地 Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# 查询安全限制
MAX_RESULT_ROWS=200
LLM_TIMEOUT_SECONDS=30
